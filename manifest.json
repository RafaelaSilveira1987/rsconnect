{
  "name": "RS Connect",
  "package_version": "36.30.7",
  "release_name": "Infraestrutura de instalação reproduzível",
  "runtime": {
    "php": ">=8.2",
    "container_image": "php:8.3-apache",
    "database": "MySQL 8.0+ / MariaDB 10.6+",
    "document_root": "public/"
  },
  "database": {
    "driver": "mysql",
    "required_migration": "109_evolution_instance_identity_cleanup.sql",
    "migration_runner": "php bin/migrate.php"
  },
  "install": {
    "local": "cp .env.local.example .env && docker compose up --build -d",
    "production": "configure .env/variables, then php bin/migrate.php verify && php bin/migrate.php up"
  }
}
