{
  "name": "RS Connect",
  "package_version": "36.32.0",
  "release_name": "Production Readiness: Go-Live",
  "runtime": {
    "php": ">=8.2",
    "container_image": "php:8.3-apache",
    "database": "MySQL 8.0+ / MariaDB 10.6+",
    "document_root": "public/"
  },
  "database": {
    "driver": "mysql",
    "required_migration": "112_tenant_lifecycle_go_live.sql",
    "migration_runner": "php bin/migrate.php"
  },
  "install": {
    "local": "cp .env.local.example .env && docker compose up --build -d",
    "production": "configure .env/variables, then php bin/migrate.php verify && php bin/migrate.php up"
  },
  "compatibility": {
    "previous_release": {
      "package_version": "36.31.3",
      "release_name": "Hotfix da saudação configurada",
      "required_migration": "111_agent_greeting_policy.sql"
    },
    "historical_releases": [
      {
        "package_version": "36.31.2",
        "release_name": "Saudação inteligente por contato",
        "required_migration": "111_agent_greeting_policy.sql"
      },
      {
        "package_version": "36.31.1",
        "release_name": "Relatórios PDF e homologação conversacional",
        "required_migration": "110_conversation_lifecycle_e2e_consistency.sql"
      },
      {
        "package_version": "36.31.0",
        "release_name": "Atendimento conversacional estruturado"
      },
      {
        "package_version": "36.30.9",
        "release_name": "Dados da conversa aprimorados"
      }
    ]
  }
}
