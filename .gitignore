# Opcional: use como fallback global; a configura√ß√£o principal deve ser por empresa.
CALENDAR_CALLBACK_TOKEN=
CALENDAR_DEFAULT_TIMEZONE=America/Sao_Paulo
CALENDAR_DEFAULT_UTC_OFFSET=-03:00

# Bloqueio de acesso ap√≥s fatura vencida
BILLING_ACCESS_GRACE_DAYS=5

OPERATIONS_MONITOR_TOKEN=

# Arquivos de ambiente e segredos
.env
.env.*
!.env.example
!.env.*.example

# Arquivos gerados em execuÁ„o
storage/logs/*.log
storage/app/white-label/*
!storage/app/white-label/.gitkeep
