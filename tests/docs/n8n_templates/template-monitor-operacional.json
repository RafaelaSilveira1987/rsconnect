{
  "name": "RS Connect - Monitor operacional",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "ScheduleOperationalMonitor",
      "name": "A cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://SEU_DOMINIO_RS_CONNECT/webhooks/operations/checks/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RS-Connect-Token",
              "value": "SEU_OPERATIONS_MONITOR_TOKEN"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "CallOperationalMonitor",
      "name": "Verificar saúde do RS Connect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 0]
    }
  ],
  "connections": {
    "A cada 15 minutos": {
      "main": [
        [
          {
            "node": "Verificar saúde do RS Connect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "rs-connect-operational-monitor-template"
  }
}
