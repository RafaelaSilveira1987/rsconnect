    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst payload = body.payload || {};\nconst appointment = payload.appointment || payload;\nconst event = String(body.event || '').trim();\nconst start = appointment.start_time || appointment.start || appointment.starts_at || '';\nconst end = appointment.end_time || appointment.end || appointment.ends_at || '';\nconst should_create = event === 'calendar.appointment.created' && Boolean(start) && Boolean(end);\nreturn [{ json: {\n  event, tenant_id: body.tenant_id || payload.tenant_id, flow_id: body.flow_id,\n  callback_url: body.callback?.url, callback_token: body.callback?.token,\n  should_create,\n  ignored_reason: should_create ? '' : (event !== 'calendar.appointment.created' ? 'evento_nao_cria_compromisso' : 'inicio_ou_fim_ausente'),\n  title: appointment.title || 'Compromisso RS Connect',\n  description: appointment.description || appointment.notes || '',\n  start, end,\n  location: appointment.meeting_url || appointment.location || '',\n  contact_name: appointment.contact?.name || payload.contact?.name || '',\n  contact_phone: appointment.contact?.phone || payload.contact?.phone || ''\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        0
      ],
      "id": "normalize_agenda",
      "name": "Normalizar Agenda"
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "start": "={{ $json.start }}",
        "end": "={{ $json.end }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary": "={{ $json.title }}",
          "description": "={{ 'Contato: ' + $json.contact_name + ' - ' + $json.contact_phone + '\\n' + $json.description }}",
          "location": "={{ $json.location }}"
        }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        20,
        -80
      ],
      "id": "google_calendar_create",
      "name": "Criar evento Google Calendar"
    },
    {
